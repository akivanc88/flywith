{
  "name": "flywith-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FlyWith stopover concierge — Jev intake router + code-owned subagents + verifier on the Anthropic SDK",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=95 tests/*.test.ts",
    "record-replay": "tsx scripts/record-replay.ts",
    "eval": "tsx evals/run.ts",
    "eval:live": "tsx evals/run.ts --live",
    "poll-fares": "tsx scripts/poll-fares.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
